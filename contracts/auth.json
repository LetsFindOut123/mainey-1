{
  "module": "auth",
  "version": "1.0",
  "session": {
    "cookie": {
      "accessToken": "mainey_access_token",
      "refreshToken": "mainey_refresh_token",
      "httpOnly": true,
      "sameSite": "lax"
    }
  },
  "endpoints": [
    {
      "name": "Signup",
      "method": "POST",
      "path": "/api/auth/signup",
      "auth": "public",
      "input": {
        "body": {
          "email": "string",
          "password": "string"
        }
      },
      "output": {
        "ok": true,
        "data": {
          "message": "string"
        }
      }
    },
    {
      "name": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "auth": "public",
      "input": {
        "body": {
          "email": "string",
          "password": "string"
        }
      },
      "output": {
        "ok": true,
        "data": {
          "user": {
            "id": "string",
            "email": "string|null"
          }
        }
      }
    },
    {
      "name": "Me",
      "method": "GET",
      "path": "/api/auth/me",
      "auth": "user",
      "input": {},
      "output": {
        "ok": true,
        "data": {
          "user": {
            "id": "string",
            "email": "string|null"
          }
        }
      }
    },
    {
      "name": "Logout",
      "method": "POST",
      "path": "/api/auth/logout",
      "auth": "user",
      "input": {},
      "output": {
        "ok": true,
        "data": {
          "message": "string"
        }
      }
    }
  ],
  "errors": [
    { "code": "bad_request", "http": 400 },
    { "code": "unauthorized", "http": 401 },
    { "code": "rate_limited", "http": 429 },
    { "code": "internal", "http": 500 }
  ]
}

