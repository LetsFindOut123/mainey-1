{
  "module": "events",
  "version": "1.0",
  "pagination": {
    "type": "cursor",
    "cursorField": "created_at",
    "params": {
      "limit": { "type": "integer", "default": 10, "min": 1, "max": 50 },
      "cursor": { "type": "string", "nullable": true }
    }
  },
  "endpoints": [
    {
      "name": "ListEvents",
      "method": "GET",
      "path": "/api/events",
      "auth": "public",
      "input": { "query": { "limit": "integer?", "cursor": "string?" } },
      "output": { "ok": true, "data": { "items": [], "pageInfo": { "nextCursor": null, "hasMore": false } } },
      "todo": "Implement Supabase-backed event listing"
    },
    {
      "name": "CreateEvent",
      "method": "POST",
      "path": "/api/events",
      "auth": "user",
      "input": { "body": { "title": "string", "date": "string", "location": "string?", "description": "string?" } },
      "output": { "ok": true, "data": { "event": {} } },
      "todo": "Implement authenticated event creation"
    },
    {
      "name": "UpdateEvent",
      "method": "PATCH",
      "path": "/api/events/:id",
      "auth": "user",
      "input": { "params": { "id": "string" }, "body": { "title": "string?", "date": "string?" } },
      "output": { "ok": true, "data": { "event": {} } },
      "todo": "Implement event updates (authz: owner)"
    },
    {
      "name": "RSVP",
      "method": "POST",
      "path": "/api/events/:id/rsvp",
      "auth": "user",
      "input": { "params": { "id": "string" }, "body": { "status": "going|interested|not_going" } },
      "output": { "ok": true, "data": { "rsvp": {} } },
      "todo": "Implement RSVP endpoint skeleton"
    }
  ],
  "errors": [
    { "code": "bad_request", "http": 400 },
    { "code": "unauthorized", "http": 401 },
    { "code": "not_found", "http": 404 },
    { "code": "internal", "http": 500 }
  ]
}

