{
  "module": "messages",
  "version": "1.0",
  "pagination": {
    "type": "cursor",
    "cursorField": "created_at",
    "params": {
      "limit": { "type": "integer", "default": 20, "min": 1, "max": 100 },
      "cursor": { "type": "string", "nullable": true }
    }
  },
  "endpoints": [
    {
      "name": "ListThreads",
      "method": "GET",
      "path": "/api/messages",
      "auth": "user",
      "input": { "query": { "limit": "integer?", "cursor": "string?" } },
      "output": { "ok": true, "data": { "items": [], "pageInfo": { "nextCursor": null, "hasMore": false } } },
      "todo": "Implement authenticated threads list skeleton"
    },
    {
      "name": "SendMessage",
      "method": "POST",
      "path": "/api/messages",
      "auth": "user",
      "input": { "body": { "toUserId": "string", "body": "string" } },
      "output": { "ok": true, "data": { "message": {} } },
      "todo": "Implement authenticated send message skeleton"
    }
  ],
  "errors": [
    { "code": "bad_request", "http": 400 },
    { "code": "unauthorized", "http": 401 },
    { "code": "internal", "http": 500 }
  ]
}

