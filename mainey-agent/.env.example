XANO_API_KEY=your_xano_key
XANO_BASE_URL=https://your-xano-domain/api

# Optional: customize how API key is sent
# - Default is Authorization: Bearer <XANO_API_KEY>
# - For X-API-Key style auth, set:
#   XANO_AUTH_HEADER=X-API-Key
#   XANO_AUTH_SCHEME=
XANO_AUTH_HEADER=Authorization
XANO_AUTH_SCHEME=Bearer

# Optional (only needed if you enable LLM planning)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent settings
MAINEY_AGENT_ROLE=developer
MAINEY_AGENT_HISTORY_PATH=.history/tasks.jsonl
MAINEY_AGENT_MEMORY_PATH=.history/memory.json
